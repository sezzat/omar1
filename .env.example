# Public origin of the site (used for canonical URLs, hreflang and the sitemap)
SITE_URL=http://localhost:3000
# Optional: base URL of the Phase 1 backend (e.g. https://api.example.com). When unset, the built-in mock PublicCatalog is used.
FLUX_API_URL=
# Secret for POST /api/revalidate, called by the backend when staff change a space or price
REVALIDATE_SECRET=change-me

# Customer portal secrets (required in production; use long random values)
JWT_SECRET=
GATEWAY_WEBHOOK_SECRET=
LINK_SECRET=
INTERNAL_SECRET=
# Optional tuning
FLUX_HOLD_MINUTES=15
FLUX_CANCEL_WINDOW_HOURS=24
# Set to 1 to expose /api/v1/dev/* in a production build (staging only)
FLUX_ENABLE_DEV_API=
